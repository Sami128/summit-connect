# Hosted Worker/local Wrangler configuration template. Contains no credentials.
# For local preview, copy to ignored .dev.vars and supply your private values.
# For publication, set these through Sites runtime environment settings instead.
DATA_DRIVER=d1
DEMO_MODE=true

# Required: replace the blank with a private random value of at least 32 characters.
# Use the same value across hosted Worker instances; mark it as a Sites secret.
DEMO_SESSION_SECRET=

# Optional AI: leave keys blank for source-based answers.
# All keys are server-only. Never prefix with NEXT_PUBLIC_ or commit real values.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# The existing OpenAI_API name is also supported as an alias for OPENAI_API_KEY.

# To use Gemini instead, set AI_PROVIDER=gemini and supply its server-only key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
