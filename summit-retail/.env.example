# Copy this file to .env.local. Never commit .env.local or paste keys into chat.
# Local synthetic prototype: no external accounts or API keys are required.
DATA_DRIVER=local
DEMO_MODE=true

# Optional locally: blank generates a private signing secret in ignored .data/.demo-secret.
# Required for a hosted demo: use one strong, private value across all instances.
DEMO_SESSION_SECRET=

# Development-only persistent data directory; relative to the project root.
# Use a separate directory for destructive or record-creating QA.
LOCAL_DATA_DIR=.data

# Shared Supabase storage. Set DATA_DRIVER=supabase after applying the SQL schema.
# All Supabase access is server-side. Never prefix these variables NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side AI. Auto uses OpenAI when its key exists, otherwise Gemini.
# With both keys blank, the assistant uses labeled source-based answers.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Existing local OpenAI_API is also accepted as an alias for OPENAI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Vercel: DATA_DRIVER=supabase; configure Supabase keys; DEMO_MODE=false for
# authenticated access. LOCAL_DATA_DIR is not used with Supabase.
# To intentionally host a synthetic demo, set DEMO_MODE=true and a strong
# DEMO_SESSION_SECRET; use a dedicated database containing synthetic data only.
